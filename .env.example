# ─── Database (AWS RDS Aurora PostgreSQL) ───────────────────
# Database credentials
DATABASE_USERNAME=your_username_here
DATABASE_PASSWORD=your_password_here

# Writer endpoint (for INSERT, UPDATE, DELETE)
DATABASE_HOST=your-cluster-name.cluster-xxxxxx.region.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_NAME=your_database_name
DATABASE_SCHEMA=your_schema_name

# Reader endpoint (for SELECT queries - load balanced across replicas)
DATABASE_READ_HOST=your-cluster-name.cluster-ro-xxxxxx.region.rds.amazonaws.com


# ─── JWT ────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── App ────────────────────────────────────────────────────
APP_NAME=RoofTop Solar Energy Marketplace
APP_VERSION=1.0.0
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

