# ─── Database (AWS RDS Aurora PostgreSQL) ───────────────────
# Database credentials
DATABASE_USERNAME=your_username
DATABASE_PASSWORD=your_password

# Writer endpoint (for INSERT, UPDATE, DELETE)
DATABASE_HOST=eccc-dev-qa-db-cluster.cluster-cmlzbcc6shng.ca-central-1.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_NAME=ecccqadbcapt
DATABASE_SCHEMA=Dummy

# Reader endpoint (for SELECT queries - load balanced across replicas)
DATABASE_READ_HOST=eccc-dev-qa-db-cluster.cluster-ro-cmlzbcc6shng.ca-central-1.rds.amazonaws.com


# ─── JWT ────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
